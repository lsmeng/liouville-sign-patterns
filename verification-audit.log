== axiom audit
@OddCase.all_four_patterns_unconditional : ∀ {N : ℕ},
  2 ≤ N →
    N ≠ 2 →
      N ≠ 3 →
        N ≠ 4 → N ≠ 5 → N ≠ 6 → N ≠ 9 → N ≠ 10 → ∀ {s t : ℤ}, s = 1 ∨ s = -1 → t = 1 ∨ t = -1 → OddCase.SignPair N s t
@OddCase.equal_pair_at_prime : ∀ {p : ℕ},
  Nat.Prime p →
    5 ≤ p →
      ∀ {e : ℤ},
        e = 1 ∨ e = -1 →
          ∃ a b,
            0 < a ∧
              0 < b ∧ a + b = p ∧ LiouvilleGoldbach.Final.liouville a = e ∧ LiouvilleGoldbach.Final.liouville b = e
@OddCase.mixedPair_of_ge : ∀ {N : ℕ}, 11 ≤ N → SignPatterns.MixedPair N
OddCase.mangerel_nonextremality : SignPatterns.MangerelNonextremality
@OddCase.legendre_of_no_equal_pair : ∀ {f : ℕ → ℤ},
  f 1 = 1 →
    (∀ (n : ℕ), 0 < n → f n = 1 ∨ f n = -1) →
      (∀ (a b : ℕ), f (a * b) = f a * f b) →
        f 2 = -1 →
          f 3 = -1 →
            f 5 = -1 →
              ∀ {p : ℕ} [inst : Fact (Nat.Prime p)],
                11 ≤ p →
                  ∀ {e : ℤ},
                    e = 1 ∨ e = -1 →
                      (¬∃ a b, 0 < a ∧ 0 < b ∧ a + b = p ∧ f a = e ∧ f b = e) →
                        p % 4 = 3 ∧ ∀ (n : ℕ), 0 < n → 2 * n < p → f n = legendreSym p ↑n
@OddCase.legendre_of_no_mixed_pair : ∀ {f : ℕ → ℤ},
  f 1 = 1 →
    (∀ (n : ℕ), 0 < n → f n = 1 ∨ f n = -1) →
      (∀ (a b : ℕ), f (a * b) = f a * f b) →
        f 2 = -1 →
          f 3 = -1 →
            ∀ {p : ℕ} [inst : Fact (Nat.Prime p)],
              7 ≤ p →
                (¬∃ a b, 0 < a ∧ 0 < b ∧ a + b = p ∧ f a ≠ f b) →
                  p % 4 = 1 ∧ ∀ (n : ℕ), 0 < n → 2 * n < p → f n = legendreSym p ↑n
